<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<RootNamespace>LibraryApp.UI</RootNamespace>
		<AssemblyName>LibraryApp.UI</AssemblyName>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<ApplicationIcon></ApplicationIcon>
		<StartupObject>LibraryApp.UI.Program</StartupObject>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="ClosedXML" Version="0.105.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LibraryApp.Models\LibraryApp.Models.csproj" />
		<ProjectReference Include="..\LibraryApp.DAL\LibraryApp.DAL.csproj" />
		<ProjectReference Include="..\LibraryApp.BLL\LibraryApp.BLL.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="App.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
