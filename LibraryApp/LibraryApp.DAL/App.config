<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<!-- ===========================================================================
       Connection string cho dự án LibraryApp (WinForms .NET 10 + SQL Server 2022)

       Lưu ý:
       - Tên "LibraryDb" phải khớp với DefaultConnectionName trong DatabaseConnection.cs
       - Encrypt=True + TrustServerCertificate=True là cấu hình khuyến nghị
         với Microsoft.Data.SqlClient từ phiên bản 4.0 trở đi.
       - MultipleActiveResultSets=True cho phép mở nhiều DataReader trên cùng
         một connection (hữu ích khi load dữ liệu cho ComboBox + DataGridView
         cùng lúc).
       =========================================================================== -->

	<connectionStrings>

		<!-- Cấu hình 1: Windows Authentication (KHUYẾN NGHỊ cho môi trường dev nội bộ) -->
		<add name="LibraryDb"
			 connectionString="Server=.;Database=HUST_Library_DEV;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Application Name=LibraryApp"
			 providerName="Microsoft.Data.SqlClient" />

		<!-- Cấu hình 2: SQL Authentication (dùng khi không có Windows AD)
    <add name="LibraryDb"
         connectionString="Server=localhost;Database=HUST_Library_DEV;User Id=lib_user;Password=YourStrong@Pass;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Application Name=LibraryApp"
         providerName="Microsoft.Data.SqlClient" />
    -->

	</connectionStrings>

</configuration>